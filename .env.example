NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
# Any MapLibre style URL. OpenFreeMap is free and needs no API key.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# mosqai-backend base URL, e.g. http://localhost:4000/v1. Staff sign in with their own accounts. Leave empty to use the built-in sample data (no sign-in).
MOSQAI_API_URL=
